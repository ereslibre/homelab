# nixpkgs names the binary `openscad` on Linux and `openscad-unstable` on
# macOS, so pick whichever the package put on PATH.
openscad := "nix shell nixpkgs#openscad-unstable -c sh -c 'exec \"$(command -v openscad-unstable || command -v openscad)\" \"$@\"' openscad"

# Render both parts side by side, as one plate: case.stl
plate: (_stl "both" "case")

# Render each part into its own file.
parts: base lid

# Render the tray: base.stl
base: (_stl "base" "base")

# Render the cover, turned over for printing: lid.stl
lid: (_stl "lid" "lid")

_stl part name:
  {{openscad}} -D 'part="{{part}}"' -o {{name}}.stl case.scad

# Render a picture of the assembled case: assembly.png
preview:
  {{openscad}} -D 'part="assembly"' --imgsize 1200,900 --viewall --autocenter -o assembly.png case.scad

# Open the model in the OpenSCAD GUI, with the parameters in the Customizer.
gui:
  {{openscad}} case.scad

# Remove everything rendered.
clean:
  rm -f case.stl base.stl lid.stl assembly.png
